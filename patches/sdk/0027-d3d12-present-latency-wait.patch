From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jerrod <jerrod.uno@gmail.com>
Date: Mon, 20 Oct 2026 01:00:00 -0400
Subject: [PATCH] d3d12 presenter: wait on the frame-latency object, not in Present

GitHub issue #16: with V-Sync forced in the NVIDIA global profile the
game ran at a third of the refresh rate (33 fps at 100 Hz). The UI thread
presents once per refresh; under forced V-Sync Present waits for a free
back buffer while holding the direct queue that the GPU emulation's
submission thread (patch 0021) also executes on, so rendering stalled
behind it.

The swap chain is now created with
DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT (max latency 2, the
non-waitable default) and painting first waits on that object, outside
the queue, so Present finds a free buffer and returns at once. ResizeBuffers
keeps the same flags; the handle is closed with the swap chain.
--d3d12_present_latency_wait (default true, restart) turns it off;
--d3d12_present_test_sync_interval=N presents with sync interval N to
reproduce a driver forcing V-Sync.

Checked on the PC 2026-10-20 (RTX 5080, windowed, stand60.rec, 30 s):
sync interval 1 without the wait 44.5 fps avg / 1% low 35.5 ms; with it
61.8 fps / 18.3 ms; no forced V-Sync 62.0 fps / 18.1 ms.
---
diff --git a/include/rex/ui/d3d12/d3d12_presenter.h b/include/rex/ui/d3d12/d3d12_presenter.h
index 83d09f7..79c9f3f 100644
--- a/include/rex/ui/d3d12/d3d12_presenter.h
+++ b/include/rex/ui/d3d12/d3d12_presenter.h
@@ -253,0 +254,3 @@ class D3D12Presenter final : public Presenter {
+    // DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT: painting waits on this
+    // before touching the queue, so Present never blocks (see PaintAndPresentImpl).
+    HANDLE frame_latency_waitable = nullptr;
diff --git a/src/ui/d3d12/d3d12_presenter.cpp b/src/ui/d3d12/d3d12_presenter.cpp
index 306118e..e50bc23 100644
--- a/src/ui/d3d12/d3d12_presenter.cpp
+++ b/src/ui/d3d12/d3d12_presenter.cpp
@@ -34,0 +35,14 @@ REXCVAR_DEFINE_BOOL(d3d12_allow_variable_refresh_rate_and_tearing, true, "UI/D3D
+REXCVAR_DEFINE_BOOL(d3d12_present_latency_wait, true, "UI/D3D12",
+                    "Wait on the swap chain's frame-latency object before painting, so a "
+                    "driver-forced V-Sync can't make Present block the shared direct queue "
+                    "(restart)");
+REXCVAR_DEFINE_INT32(d3d12_present_test_sync_interval, 0, "UI/D3D12",
+                     "Testing: present with this sync interval (1 = V-Sync), the way a driver "
+                     "that forces V-Sync does");
+
+namespace {
+UINT SwapChainFlags(bool allows_tearing, bool latency_waitable) {
+  return (allows_tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0) |
+         (latency_waitable ? DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT : 0);
+}
+}  // namespace
@@ -366 +380,2 @@ D3D12Presenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(Surface& new_sur
-        paint_context_.swap_chain_allows_tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0));
+        SwapChainFlags(paint_context_.swap_chain_allows_tearing,
+                       paint_context_.frame_latency_waitable != nullptr)));
@@ -415,0 +431,3 @@ D3D12Presenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(Surface& new_sur
+    if (REXCVAR_GET(d3d12_present_latency_wait)) {
+      swap_chain_desc.Flags |= DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT;
+    }
@@ -452,0 +471,6 @@ D3D12Presenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(Surface& new_sur
+    if (swap_chain_desc.Flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT) {
+      // Two frames queued at most, like the DXGI default for non-waitable chains.
+      paint_context_.swap_chain->SetMaximumFrameLatency(2);
+      paint_context_.frame_latency_waitable =
+          paint_context_.swap_chain->GetFrameLatencyWaitableObject();
+    }
@@ -550,0 +575,4 @@ void D3D12Presenter::PaintContext::DestroySwapChain() {
+  if (frame_latency_waitable) {
+    CloseHandle(frame_latency_waitable);
+    frame_latency_waitable = nullptr;
+  }
@@ -557,0 +586,9 @@ Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawe
+  // When a driver forces V-Sync, Present waits for a free back buffer while
+  // holding the direct queue that the GPU emulation's submission thread also
+  // uses, which stalled the game to a fraction of the refresh rate (GitHub
+  // issue #16, 33 fps at 100 Hz). Waiting here instead keeps that wait off the
+  // queue. The timeout only guards against a lost signal.
+  if (paint_context_.frame_latency_waitable) {
+    WaitForSingleObjectEx(paint_context_.frame_latency_waitable, 100, TRUE);
+  }
+
@@ -1157,0 +1195 @@ Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawe
+  const UINT sync_interval = UINT(std::clamp(REXCVAR_GET(d3d12_present_test_sync_interval), 0, 4));
@@ -1159,2 +1197,4 @@ Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawe
-      0, DXGI_PRESENT_RESTART |
-             (paint_context_.swap_chain_allows_tearing ? DXGI_PRESENT_ALLOW_TEARING : 0));
+      sync_interval,
+      DXGI_PRESENT_RESTART |
+          (paint_context_.swap_chain_allows_tearing && !sync_interval ? DXGI_PRESENT_ALLOW_TEARING
+                                                                     : 0));
